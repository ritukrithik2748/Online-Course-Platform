# Backend service (FastAPI) - copy to .env and adjust
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=onlinelearning

# Use a long random string in production (32+ characters)
SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Browser origins allowed to call this service directly.
# The gateway is the public entry point; add the gateway origin here.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Google Sign-In OAuth 2.0 Web client ID — must match the frontend's
# VITE_GOOGLE_CLIENT_ID. Leave empty to disable /api/auth/google.
GOOGLE_CLIENT_ID=
